"""
Multiple Linear Regression
--------------------------

Multiple Linear Regression is used when:
- There is MORE THAN ONE feature (input)
- We predict ONE output (label)

Example:
Study hours + Attendance -> Predict marks
"""

# -----------------------------------
# Import required libraries
# -----------------------------------
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression


# -----------------------------------
# Create a dataset
# -----------------------------------
# Features:
# hours       -> number of study hours
# attendance  -> attendance percentage
# Label:
# marks       -> student marks

data = {
    "hours": [1, 2, 3, 4, 5, 6, 7, 8],
    "attendance": [60, 65, 70, 75, 80, 85, 90, 95],
    "marks": [35, 40, 50, 60, 70, 78, 85, 90]
}

df = pd.DataFrame(data)

print("Dataset:")
print(df)
print("-" * 40)


# -----------------------------------
# Features & Label
# -----------------------------------
X = df[["hours", "attendance"]]  # Multiple features
y = df["marks"]                  # Single label

print("Features (X):")
print(X)
print("\nLabel (y):")
print(y)
print("-" * 40)


# -----------------------------------
# Train-Test Split
# -----------------------------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.25,
    random_state=42
)

print("Training Data Shape:", X_train.shape)
print("Testing Data Shape:", X_test.shape)
print("-" * 40)


# -----------------------------------
# Train the Multiple Linear Regression model
# -----------------------------------
model = LinearRegression()
model.fit(X_train, y_train)

print("Model trained successfully.")
print("-" * 40)


# -----------------------------------
# Predictions
# -----------------------------------
predictions = model.predict(X_test)

print("Predicted Marks:")
print(predictions)

print("\nActual Marks:")
print(y_test.values)
print("-" * 40)

