"""
Polynomial Regression
---------------------

Polynomial Regression is used when:
- The relationship between feature and label is NOT linear
- Data follows a curve (non-linear pattern)

Example:
Study hours -> Marks (but growth is not straight)

Simple Idea:

linear => y = mx + c

polynomial => y = ax^2 + bx + c
"""



# -----------------------------------
# Import required libraries
# -----------------------------------
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures


# -----------------------------------
# Create a dataset
# -----------------------------------
# Feature:
# hours -> study hours
# Label:
# marks -> student marks (non-linear pattern)

data = {
    "hours": [1, 2, 3, 4, 5, 6, 7],
    "marks": [20, 30, 45, 65, 80, 90, 95]
}

df = pd.DataFrame(data)

print("Dataset:")
print(df)
print("-" * 40)


# -----------------------------------
# Features & Label
# -----------------------------------
X = df[["hours"]]
y = df["marks"]


# -----------------------------------
# Train-Test Split
# -----------------------------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.3,
    random_state=42
)


# -----------------------------------
# Convert to Polynomial Features
# -----------------------------------
# degree=2 -> quadratic equation

poly = PolynomialFeatures(degree=2)
X_train_poly = poly.fit_transform(X_train)
X_test_poly = poly.transform(X_test)


# -----------------------------------
# Train the Polynomial Regression model
# -----------------------------------
model = LinearRegression()
model.fit(X_train_poly, y_train)

print("Polynomial Regression model trained.")
print("-" * 40)


# -----------------------------------
# Predictions
# -----------------------------------
predictions = model.predict(X_test_poly)

print("Predicted Marks:")
print(predictions)

print("\nActual Marks:")
print(y_test.values)
print("-" * 40)


# -----------------------------------
# Model Equation Explanation
# -----------------------------------
"""
Polynomial Regression equation (degree=2):

y = b0 + b1*x + b2*x^2

Why Polynomial Regression?
- Linear Regression fails on curved data
- Polynomial Regression captures non-linear patterns

Warning:
- High degree can cause Overfitting
- Choose degree carefully
"""
