import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression

df = pd.DataFrame({
    "hours" : [1,2,3,4,5,6,7,8],
    "marks" : [35,45,55,65,75,85,95,105]
})

x = df[["hours"]]
y = df["marks"]

x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.2)   #here I removed the random_state because for not to get fixed number

print("Training Features (X_train):")
print(x_train)
print("\nTraining Labels (y_train):")
print(y_train)

print("\nTesting Features (X_test):")
print(x_test)
print("\nTesting Labels (y_test):")
print(y_test)
print("-" * 40)

model = LinearRegression()
model.fit(x_train,y_train)

y_pred = model.predict(x_test)
print(y_pred)

print(model.score(x_test,y_test))



